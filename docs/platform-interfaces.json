{
  "repository": "monarchic-agent-protocol",
  "summary": "Shared versioned protocol contracts and generated language bindings for Monarchic AI agents, runners, orchestration, and client boundaries.",
  "public_interfaces": [
    {
      "id": "monarchic-agent-protocol",
      "name": "Monarchic Agent Protocol",
      "kind": "protocol-contracts",
      "surfaces": [
        "schemas/v1/*.json",
        "src/rust/lib.rs",
        "src/ts/index.ts",
        "proto/monarchic_agent_protocol.proto",
        "fixtures/client_boundary/v1/*.json"
      ]
    }
  ],
  "nix_discovery": {
    "validation_commands": [
      "cargo test",
      "bash scripts/test-json-schema.sh",
      "bash scripts/test-readme-schema-index-coverage.sh"
    ]
  }
}
