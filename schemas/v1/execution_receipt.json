{
  "$id": "https://monarchic.ai/schema/v1/execution_receipt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionReceipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "run_id",
    "plan_id",
    "plan_hash",
    "task_hashes",
    "artifact_hashes",
    "outcome_hash",
    "status",
    "generated_at_ms"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": ["v1"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "task_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome_hash": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "plan_status.json"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "failure_detail.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
